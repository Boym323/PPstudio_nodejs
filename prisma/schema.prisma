generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  OWNER
  SALON
}

enum AvailabilitySlotStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

enum AvailabilitySlotServiceRestrictionMode {
  ANY
  SELECTED
}

enum AvailabilityAuditOperation {
  ADD
  REMOVE
  CLEAR
  COPY_WEEK
  APPLY_TEMPLATE
  SYNC_DRAFT
  UNDO
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  WEB
  PHONE
  INSTAGRAM
  IN_PERSON
  OTHER
}

enum BookingAcquisitionSource {
  DIRECT
  FACEBOOK
  GOOGLE
  INSTAGRAM
  FIRMY_CZ
  OTHER
}

enum BookingActorType {
  USER
  CLIENT
  SYSTEM
}

enum BookingPaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum BookingPaymentStatus {
  ACTIVE
  VOIDED
}

enum BookingActionTokenType {
  CANCEL
  RESCHEDULE
  APPROVE
  REJECT
}

enum EmailLogStatus {
  PENDING
  SENT
  FAILED
}

enum EmailAudience {
  CLIENT
  ADMIN
  EXTERNAL
}

enum EmailLogType {
  BOOKING_CREATED
  BOOKING_RECEIVED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  BOOKING_REMINDER
  VOUCHER_SENT
  GENERIC
}

enum EmailIncidentResolutionKind {
  DELIVERED_RESEND
  MANUAL
}

enum EmailIncidentManualResolutionReason {
  HISTORICAL
  CONTACTED_OTHER_WAY
  NO_LONGER_RELEVANT
  OTHER
}

enum BookingSubmissionOutcome {
  SUCCESS
  FAILED
  BLOCKED
}

enum MediaStorageProvider {
  LOCAL
}

enum MediaAssetVisibility {
  PUBLIC
  PRIVATE
}

enum MediaCollectionType {
  CERTIFICATES
  STUDIO_GALLERY
  REFERENCES
}

enum ServiceMediaRole {
  HERO
  GALLERY
}

enum PricingLayout {
  LIST
  GRID
}

enum PricingIconKey {
  DROPLET
  EYE_LASHES
  LOTUS
  BRUSH
  LEAF
  LIPSTICK
  SPARK
}

enum CalendarFeedScope {
  OWNER_BOOKINGS
}

enum VoucherType {
  VALUE
  SERVICE
}

enum VoucherStatus {
  DRAFT
  ACTIVE
  PARTIALLY_REDEEMED
  REDEEMED
  EXPIRED
  CANCELLED
}

enum AdminUserAuditOperation {
  CREATE
  UPDATE_PROFILE
  CHANGE_ROLE
  ACTIVATE
  DEACTIVATE
  INVITE_RESEND
}

enum VoucherChangeOperation {
  UPDATE_OPERATIONAL_DETAILS
  CANCEL
}

enum ServiceChangeOperation {
  UPDATE_OPERATIONAL_DETAILS
  TOGGLE_ACTIVE
  TOGGLE_BOOKABLE
}

enum SiteSettingsChangeOperation {
  UPDATE_SALON
  UPDATE_BOOKING_POLICY
  UPDATE_EMAIL
}

model AdminUser {
  id                             String                    @id @default(cuid())
  email                          String                    @unique
  name                           String
  role                           AdminRole
  passwordHash                   String?
  isActive                       Boolean                   @default(true)
  invitedAt                      DateTime?
  lastLoginAt                    DateTime?
  createdAt                      DateTime                  @default(now())
  updatedAt                      DateTime                  @updatedAt
  inviteTokens                   AdminUserInviteToken[]
  createdAvailabilitySlots       AvailabilitySlot[]        @relation("AvailabilitySlotCreatedBy")
  createdBookings                Booking[]                 @relation("BookingCreatedBy")
  bookingStatusHistoryItems      BookingStatusHistory[]    @relation("BookingStatusHistoryActor")
  bookingRescheduleLogs          BookingRescheduleLog[]    @relation("BookingRescheduleLogActor")
  servicePriceChangeLogs         ServicePriceChangeLog[]   @relation("ServicePriceChangeLogActor")
  updatedCalendarFeeds           CalendarFeed[]            @relation("CalendarFeedUpdatedBy")
  updatedSettings                Setting[]                 @relation("SettingUpdatedBy")
  updatedSiteSettings            SiteSettings[]            @relation("SiteSettingsUpdatedBy")
  updatedAutoLunchOverrides      AutoLunchDayOverride[]    @relation("AutoLunchDayOverrideUpdatedBy")
  notificationSettings           UserNotificationSettings?
  createdVouchers                Voucher[]                 @relation("AdminUserCreatedVouchers")
  cancelledVouchers              Voucher[]                 @relation("VoucherCancelledBy")
  updatedVouchers                Voucher[]                 @relation("VoucherUpdatedBy")
  redeemedVoucherRedemptions     VoucherRedemption[]       @relation("AdminUserRedeemedVoucherRedemptions")
  manuallyResolvedEmailIncidents EmailLog[]                @relation("EmailLogIncidentManualResolution")
  bookingPayments                BookingPayment[]          @relation("BookingPaymentCreatedBy")
  voidedBookingPayments          BookingPayment[]          @relation("BookingPaymentVoidedBy")
  adjustedBookingPrices          Booking[]                 @relation("BookingPriceAdjustedBy")
  availabilityAuditEvents        AvailabilityAuditEvent[]  @relation("AvailabilityAuditEventActor")
  targetedAdminUserAudits        AdminUserAuditEvent[]     @relation("AdminUserAuditTarget")
  authoredAdminUserAudits        AdminUserAuditEvent[]     @relation("AdminUserAuditActor")
  voucherChangeLogs              VoucherChangeLog[]        @relation("VoucherChangeLogActor")
  serviceChangeLogs              ServiceChangeLog[]        @relation("ServiceChangeLogActor")
  siteSettingsChangeLogs         SiteSettingsChangeLog[]   @relation("SiteSettingsChangeLogActor")
}

model AdminUserAuditEvent {
  id           String                  @id @default(cuid())
  targetUserId String
  actorUserId  String
  operation    AdminUserAuditOperation
  before       Json
  after        Json
  createdAt    DateTime                @default(now())
  targetUser   AdminUser               @relation("AdminUserAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  actorUser    AdminUser               @relation("AdminUserAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt])
  @@index([createdAt, id])
}

model UserNotificationSettings {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  pushoverUserKey          String?
  pushoverEnabled          Boolean   @default(false)
  notifyNewBooking         Boolean   @default(true)
  notifyBookingConfirmed   Boolean   @default(true)
  notifyBookingCancelled   Boolean   @default(true)
  notifyBookingRescheduled Boolean   @default(true)
  notifyBookingPending     Boolean   @default(true)
  notifyEmailFailed        Boolean   @default(true)
  notifyReminderFailed     Boolean   @default(true)
  notifySystemErrors       Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pushoverEnabled])
}

model AdminUserInviteToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt, revokedAt])
}

model ServiceCategory {
  id                 String         @id @default(cuid())
  name               String
  slug               String         @unique
  description        String?
  publicName         String?
  pricingDescription String?
  pricingLayout      PricingLayout  @default(GRID)
  pricingIconKey     PricingIconKey @default(SPARK)
  sortOrder          Int            @default(0)
  pricingSortOrder   Int            @default(0)
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  services           Service[]

  @@index([isActive, sortOrder])
  @@index([isActive, pricingSortOrder])
}

model Service {
  id                       String                    @id @default(cuid())
  categoryId               String
  name                     String
  publicName               String?
  slug                     String                    @unique
  shortDescription         String?
  description              String?
  publicIntro              String?
  seoTitle                 String?
  seoDescription           String?
  idealFor                 String[]                  @default([])
  includes                 String[]                  @default([])
  benefits                 String[]                  @default([])
  goodToKnow               String[]                  @default([])
  pricingShortDescription  String?
  pricingBadge             String?
  durationMinutes          Int
  cleanupMinutes           Int                       @default(0)
  priceFromCzk             Int?
  sortOrder                Int                       @default(0)
  isFeaturedOnHomepage     Boolean                   @default(false)
  homepageSortOrder        Int                       @default(0)
  isActive                 Boolean                   @default(true)
  isPubliclyBookable       Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  category                 ServiceCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  allowedAvailabilitySlots AvailabilitySlotService[]
  bookings                 Booking[]
  submissionLogs           BookingSubmissionLog[]
  priceChangeLogs          ServicePriceChangeLog[]
  changeLogs               ServiceChangeLog[]
  vouchers                 Voucher[]                 @relation("ServiceVouchers")
  voucherRedemptions       VoucherRedemption[]       @relation("ServiceVoucherRedemptions")
  media                    ServiceMedia[]

  @@index([categoryId, isActive, isPubliclyBookable, sortOrder])
  @@index([isActive, isPubliclyBookable, sortOrder])
  @@index([isFeaturedOnHomepage, homepageSortOrder])
}

model ServiceMedia {
  id           String           @id @default(cuid())
  serviceId    String
  mediaAssetId String
  role         ServiceMediaRole
  sortOrder    Int              @default(0)
  altText      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  service      Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([serviceId, role, mediaAssetId])
  @@unique([serviceId, role, sortOrder])
  @@index([mediaAssetId])
  @@index([serviceId, role, sortOrder, id])
}

model ServiceChangeLog {
  id          String                 @id @default(cuid())
  serviceId   String
  actorUserId String
  operation   ServiceChangeOperation
  before      Json
  after       Json
  createdAt   DateTime               @default(now())
  service     Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  actorUser   AdminUser              @relation("ServiceChangeLogActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([serviceId, createdAt])
  @@index([createdAt, id])
}

model ServicePriceChangeLog {
  id              String     @id @default(cuid())
  serviceId       String
  changedByUserId String?
  oldPriceFromCzk Int?
  newPriceFromCzk Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  service         Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  changedByUser   AdminUser? @relation("ServicePriceChangeLogActor", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([serviceId, createdAt])
  @@index([changedByUserId, createdAt])
}

model AvailabilitySlot {
  id                     String                                 @id @default(cuid())
  startsAt               DateTime
  endsAt                 DateTime
  /// PP Studio obsluhuje jeden zdroj; databázový CHECK v migraci vynucuje hodnotu 1.
  capacity               Int                                    @default(1)
  status                 AvailabilitySlotStatus                 @default(DRAFT)
  serviceRestrictionMode AvailabilitySlotServiceRestrictionMode @default(ANY)
  publicNote             String?
  internalNote           String?
  publishedAt            DateTime?
  cancelledAt            DateTime?
  createdByUserId        String?
  createdAt              DateTime                               @default(now())
  updatedAt              DateTime                               @updatedAt
  createdByUser          AdminUser?                             @relation("AvailabilitySlotCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  allowedServices        AvailabilitySlotService[]
  bookings               Booking[]
  submissionLogs         BookingSubmissionLog[]

  @@index([status, startsAt])
  @@index([serviceRestrictionMode, startsAt])
  @@index([startsAt, endsAt])
  @@index([createdByUserId])
}

/// Neměnná auditní stopa administrátorských změn dostupnosti.
model AvailabilityAuditEvent {
  id                     String                     @id @default(cuid())
  actorUserId            String?
  actorRole              AdminRole?
  adminArea              String?
  dateKey                String
  timeZone               String                     @default("Europe/Prague")
  operation              AvailabilityAuditOperation
  source                 String
  operationId            String
  revertedOperationId    String?
  before                 Json
  after                  Json
  createdSlots           Json
  archivedOrRemovedSlots Json
  createdAt              DateTime                   @default(now())
  actorUser              AdminUser?                 @relation("AvailabilityAuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([dateKey, createdAt])
  @@index([operationId])
  @@index([revertedOperationId])
  @@index([actorUserId, createdAt])
}

/// Idempotentní zápis jedné interaktivní změny dostupnosti planneru.
model AvailabilityOperation {
  operationId   String   @id
  fingerprint   String
  weekKey       String
  resultMessage String
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model AvailabilitySlotService {
  slotId    String
  serviceId String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  slot      AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  service   Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([slotId, serviceId])
  @@index([serviceId, slotId])
}

model Client {
  id             String                 @id @default(cuid())
  fullName       String
  email          String?                @unique
  phone          String?
  internalNote   String?
  isActive       Boolean                @default(true)
  lastBookedAt   DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  bookings       Booking[]
  emailLogs      EmailLog[]
  submissionLogs BookingSubmissionLog[]

  @@index([phone])
  @@index([isActive, fullName])
}

model Booking {
  id                          String                    @id @default(cuid())
  clientId                    String
  slotId                      String
  serviceId                   String
  source                      BookingSource             @default(WEB)
  acquisitionSource           BookingAcquisitionSource?
  acquisitionReferrerHost     String?
  acquisitionUtmSource        String?
  acquisitionUtmMedium        String?
  acquisitionUtmCampaign      String?
  isManual                    Boolean                   @default(false)
  manualOverride              Boolean                   @default(false)
  status                      BookingStatus             @default(PENDING)
  clientNameSnapshot          String
  clientEmailSnapshot         String
  communicationGeneration     Int                       @default(1)
  clientDeliveryLeaseToken    String?
  clientDeliveryLeaseExpiresAt DateTime?
  clientPhoneSnapshot         String?
  serviceNameSnapshot         String
  serviceDurationMinutes      Int
  cleanupMinutes              Int                       @default(0)
  cleanupBlockMinutes         Int                       @default(0)
  servicePriceFromCzk         Int?
  finalPriceCzk               Int?
  priceAdjustmentReason       String?
  priceAdjustedAt             DateTime?
  priceAdjustedByUserId       String?
  scheduledStartsAt           DateTime
  scheduledEndsAt             DateTime
  blockedUntil                DateTime?
  originalAvailabilityEndsAt  DateTime?
  clientNote                  String?
  internalNote                String?
  confirmedAt                 DateTime?
  reminder24hQueuedAt         DateTime?
  reminder24hSentAt           DateTime?
  cancelledAt                 DateTime?
  completedAt                 DateTime?
  rescheduledAt               DateTime?
  rescheduleCount             Int                       @default(0)
  rescheduledFromBookingId    String?                   @unique
  intendedVoucherId           String?
  intendedVoucherCodeSnapshot String?
  intendedVoucherValidatedAt  DateTime?
  createdByUserId             String?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  client                      Client                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  slot                        AvailabilitySlot          @relation(fields: [slotId], references: [id], onDelete: Restrict)
  service                     Service                   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdByUser               AdminUser?                @relation("BookingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  priceAdjustedByUser         AdminUser?                @relation("BookingPriceAdjustedBy", fields: [priceAdjustedByUserId], references: [id], onDelete: SetNull)
  rescheduledFromBooking      Booking?                  @relation("BookingRescheduleChain", fields: [rescheduledFromBookingId], references: [id], onDelete: SetNull)
  rescheduledToBooking        Booking?                  @relation("BookingRescheduleChain")
  intendedVoucher             Voucher?                  @relation("BookingIntendedVoucher", fields: [intendedVoucherId], references: [id], onDelete: SetNull)
  statusHistory               BookingStatusHistory[]
  rescheduleLogs              BookingRescheduleLog[]
  actionTokens                BookingActionToken[]
  emailLogs                   EmailLog[]
  submissionLogs              BookingSubmissionLog[]
  voucherRedemptions          VoucherRedemption[]
  payments                    BookingPayment[]

  @@index([slotId, status])
  @@index([clientId, createdAt])
  @@index([serviceId, scheduledStartsAt])
  @@index([status, scheduledStartsAt])
  @@index([status, reminder24hSentAt, scheduledStartsAt])
  @@index([status, reminder24hQueuedAt, scheduledStartsAt])
  @@index([source, createdAt])
  @@index([acquisitionSource, createdAt])
  @@index([createdByUserId])
  @@index([priceAdjustedByUserId])
  @@index([intendedVoucherId])
  @@index([clientDeliveryLeaseExpiresAt])
  @@index([rescheduledAt])
}

model BookingPayment {
  id              String               @id @default(cuid())
  bookingId       String
  amountCzk       Int
  method          BookingPaymentMethod
  paidAt          DateTime             @default(now())
  note            String?
  status          BookingPaymentStatus @default(ACTIVE)
  voidedAt        DateTime?
  voidedByUserId  String?
  voidReason      String?
  idempotencyKey  String?              @unique
  createdByUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  booking         Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdByUser   AdminUser?           @relation("BookingPaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  voidedByUser    AdminUser?           @relation("BookingPaymentVoidedBy", fields: [voidedByUserId], references: [id], onDelete: SetNull)

  @@index([bookingId, paidAt])
  @@index([method, paidAt])
  @@index([createdByUserId])
  @@index([voidedByUserId])
  @@index([bookingId, status])
}

model Voucher {
  id                      String              @id @default(cuid())
  code                    String              @unique
  type                    VoucherType
  status                  VoucherStatus       @default(DRAFT)
  purchaserName           String?
  purchaserEmail          String?
  recipientName           String?
  message                 String?
  originalValueCzk        Int?
  remainingValueCzk       Int?
  serviceId               String?
  serviceNameSnapshot     String?
  servicePriceSnapshotCzk Int?
  serviceDurationSnapshot Int?
  validFrom               DateTime            @default(now())
  validUntil              DateTime?
  issuedAt                DateTime?
  cancelledAt             DateTime?
  cancelledByUserId       String?
  cancelReason            String?
  updatedByUserId         String?
  internalNote            String?
  createdByUserId         String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  service                 Service?            @relation("ServiceVouchers", fields: [serviceId], references: [id], onDelete: SetNull)
  createdByUser           AdminUser?          @relation("AdminUserCreatedVouchers", fields: [createdByUserId], references: [id], onDelete: SetNull)
  cancelledByUser         AdminUser?          @relation("VoucherCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  updatedByUser           AdminUser?          @relation("VoucherUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  intendedBookings        Booking[]           @relation("BookingIntendedVoucher")
  redemptions             VoucherRedemption[]
  changeLogs              VoucherChangeLog[]

  @@index([code])
  @@index([status, validUntil])
  @@index([type, status])
  @@index([serviceId])
  @@index([createdByUserId])
  @@index([cancelledByUserId])
  @@index([updatedByUserId])
}

model VoucherChangeLog {
  id          String                 @id @default(cuid())
  voucherId   String
  actorUserId String
  operation   VoucherChangeOperation
  before      Json
  after       Json
  createdAt   DateTime               @default(now())
  voucher     Voucher                @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  actorUser   AdminUser              @relation("VoucherChangeLogActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([voucherId, createdAt])
  @@index([createdAt, id])
}

model VoucherRedemption {
  id                  String     @id @default(cuid())
  voucherId           String
  bookingId           String?
  amountCzk           Int?
  serviceId           String?
  serviceNameSnapshot String?
  note                String?
  redeemedByUserId    String?
  redeemedAt          DateTime   @default(now())
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  voucher             Voucher    @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  booking             Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  service             Service?   @relation("ServiceVoucherRedemptions", fields: [serviceId], references: [id], onDelete: SetNull)
  redeemedByUser      AdminUser? @relation("AdminUserRedeemedVoucherRedemptions", fields: [redeemedByUserId], references: [id], onDelete: SetNull)

  @@index([voucherId, redeemedAt])
  @@index([bookingId])
  @@index([serviceId])
  @@index([redeemedByUserId, redeemedAt])
}

model BookingRescheduleLog {
  id              String     @id @default(cuid())
  bookingId       String
  oldStartAt      DateTime
  oldEndAt        DateTime
  newStartAt      DateTime
  newEndAt        DateTime
  changedByUserId String?
  changedByClient Boolean    @default(false)
  reason          String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  booking         Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedByUser   AdminUser? @relation("BookingRescheduleLogActor", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([changedByUserId, createdAt])
}

model BookingStatusHistory {
  id          String           @id @default(cuid())
  bookingId   String
  status      BookingStatus
  actorType   BookingActorType
  actorUserId String?
  reason      String?
  note        String?
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorUser   AdminUser?       @relation("BookingStatusHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([actorUserId, createdAt])
}

model BookingActionToken {
  id         String                 @id @default(cuid())
  bookingId  String
  type       BookingActionTokenType
  tokenHash  String                 @unique
  expiresAt  DateTime
  usedAt     DateTime?
  revokedAt  DateTime?
  lastSentAt DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  booking    Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  emailLogs  EmailLog[]

  @@index([bookingId, type, expiresAt])
  @@index([expiresAt])
}

model EmailLog {
  id                             String                               @id @default(cuid())
  bookingId                      String?
  clientId                       String?
  actionTokenId                  String?
  type                           EmailLogType
  audience                       EmailAudience                        @default(EXTERNAL)
  status                         EmailLogStatus                       @default(PENDING)
  attemptCount                   Int                                  @default(0)
  nextAttemptAt                  DateTime                             @default(now())
  processingStartedAt            DateTime?
  processingToken                String?
  communicationGeneration        Int                                  @default(1)
  recipientEmail                 String
  subject                        String
  templateKey                    String
  payload                        Json?
  provider                       String?
  providerMessageId              String?
  trackingLastEvent              String?
  trackingLastEventAt            DateTime?
  trackingDeliveredAt            DateTime?
  trackingOpenedAt               DateTime?
  trackingClickedAt              DateTime?
  trackingBouncedAt              DateTime?
  trackingComplainedAt           DateTime?
  trackingFailedAt               DateTime?
  trackingSuppressedAt           DateTime?
  trackingRawPayload             Json?
  resendOfId                     String?
  resendRootId                   String?
  incidentResolvedAt             DateTime?
  incidentResolvedByEmailLogId   String?
  incidentResolutionKind         EmailIncidentResolutionKind?
  incidentManualResolvedByUserId String?
  incidentManualResolutionReason EmailIncidentManualResolutionReason?
  incidentManualResolutionNote   String?
  errorMessage                   String?
  sentAt                         DateTime?
  createdAt                      DateTime                             @default(now())
  updatedAt                      DateTime                             @updatedAt
  booking                        Booking?                             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  client                         Client?                              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  actionToken                    BookingActionToken?                  @relation(fields: [actionTokenId], references: [id], onDelete: SetNull)
  resendOf                       EmailLog?                            @relation("EmailLogResendChain", fields: [resendOfId], references: [id], onDelete: Restrict)
  resends                        EmailLog[]                           @relation("EmailLogResendChain")
  resendRoot                     EmailLog?                            @relation("EmailLogIncidentRoot", fields: [resendRootId], references: [id], onDelete: Restrict)
  incidentResends                EmailLog[]                           @relation("EmailLogIncidentRoot")
  incidentManualResolvedByUser   AdminUser?                           @relation("EmailLogIncidentManualResolution", fields: [incidentManualResolvedByUserId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
  @@index([clientId, createdAt])
  @@index([actionTokenId, createdAt])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([processingStartedAt])
  @@index([providerMessageId])
  @@index([resendOfId])
  @@index([resendRootId])
  @@index([incidentResolvedAt])
  @@index([incidentManualResolvedByUserId])
}

model EmailProviderWebhookEvent {
  id                String    @id @default(cuid())
  provider          String
  providerEventId   String
  eventType         String
  providerMessageId String?
  providerEventAt   DateTime?
  receivedAt        DateTime  @default(now())
  processedAt       DateTime
  outcome           String

  @@unique([provider, providerEventId])
  @@index([providerMessageId])
  @@index([receivedAt])
}

model BookingSubmissionLog {
  id            String                   @id @default(cuid())
  bookingId     String?
  clientId      String?
  serviceId     String?
  slotId        String?
  ipHash        String?
  emailHash     String?
  outcome       BookingSubmissionOutcome
  failureCode   String?
  failureReason String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  booking       Booking?                 @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  client        Client?                  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  service       Service?                 @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  slot          AvailabilitySlot?        @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([clientId, createdAt])
  @@index([serviceId, createdAt])
  @@index([slotId, createdAt])
  @@index([ipHash, createdAt])
  @@index([emailHash, createdAt])
  @@index([outcome, createdAt])
}

model RateLimitReservation {
  id          String   @id @default(cuid())
  scope       String
  fingerprint String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([scope, fingerprint, expiresAt])
  @@index([expiresAt])
}

model PushoverNotificationCooldown {
  id         String   @id @default(cuid())
  eventType  String
  sourceHash String
  lastSentAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([eventType, sourceHash])
  @@index([lastSentAt])
}

model Setting {
  id              String     @id @default(cuid())
  key             String     @unique
  value           Json
  description     String?
  updatedByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  updatedByUser   AdminUser? @relation("SettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

model SiteSettings {
  id                       String                  @id @default("site-settings")
  salonName                String
  addressLine              String
  city                     String
  postalCode               String
  phone                    String
  contactEmail             String
  instagramUrl             String?
  bookingMinAdvanceHours   Int                     @default(2)
  bookingMaxAdvanceDays    Int                     @default(90)
  bookingCancellationHours Int                     @default(48)
  autoLunchEnabled         Boolean                 @default(true)
  notificationAdminEmail   String
  emailSenderName          String
  emailSenderEmail         String
  emailFooterText          String?
  voucherPdfLogoMediaId    String?
  contactPhotoMediaId      String?
  homePortraitMediaId      String?
  aboutPortraitMediaId     String?
  updatedByUserId          String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  updatedByUser            AdminUser?              @relation("SiteSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  voucherPdfLogoMedia      MediaAsset?             @relation("SiteSettingsVoucherPdfLogo", fields: [voucherPdfLogoMediaId], references: [id], onDelete: SetNull)
  contactPhotoMedia        MediaAsset?             @relation("SiteSettingsContactPhoto", fields: [contactPhotoMediaId], references: [id], onDelete: SetNull)
  homePortraitMedia        MediaAsset?             @relation("SiteSettingsHomePortrait", fields: [homePortraitMediaId], references: [id], onDelete: SetNull)
  aboutPortraitMedia       MediaAsset?             @relation("SiteSettingsAboutPortrait", fields: [aboutPortraitMediaId], references: [id], onDelete: SetNull)
  changeLogs               SiteSettingsChangeLog[]

  @@index([updatedByUserId])
  @@index([voucherPdfLogoMediaId])
  @@index([contactPhotoMediaId])
  @@index([homePortraitMediaId])
  @@index([aboutPortraitMediaId])
}

/// Výslovné vypnutí automatického oběda pro lokální pražský den; absence znamená AUTO.
model AutoLunchDayOverride {
  dateKey         String     @id
  updatedByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  updatedByUser   AdminUser? @relation("AutoLunchDayOverrideUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

model SiteSettingsChangeLog {
  id             String                      @id @default(cuid())
  siteSettingsId String
  actorUserId    String
  operation      SiteSettingsChangeOperation
  before         Json
  after          Json
  createdAt      DateTime                    @default(now())
  siteSettings   SiteSettings                @relation(fields: [siteSettingsId], references: [id], onDelete: Restrict)
  actorUser      AdminUser                   @relation("SiteSettingsChangeLogActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([siteSettingsId, createdAt])
  @@index([createdAt, id])
}

model CalendarFeed {
  id              String            @id @default(cuid())
  scope           CalendarFeedScope @unique
  tokenSalt       String
  isActive        Boolean           @default(false)
  rotatedAt       DateTime?
  revokedAt       DateTime?
  updatedByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  updatedByUser   AdminUser?        @relation("CalendarFeedUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

model MediaAsset {
  id                     String                @id @default(cuid())
  storageProvider        MediaStorageProvider  @default(LOCAL)
  visibility             MediaAssetVisibility  @default(PUBLIC)
  originalFilename       String
  fileName               String
  mimeType               String
  extension              String
  size                   Int
  width                  Int?
  height                 Int?
  altText                String?
  title                  String?
  storagePath            String                @unique
  url                    String
  optimizedStoragePath   String?               @unique
  optimizedUrl           String?
  optimizedMimeType      String?
  optimizedWidth         Int?
  optimizedHeight        Int?
  optimizedSize          Int?
  thumbnailStoragePath   String?               @unique
  thumbnailUrl           String?
  thumbnailMimeType      String?
  thumbnailWidth         Int?
  thumbnailHeight        Int?
  thumbnailSize          Int?
  isPublished            Boolean               @default(true)
  deletionRequestedAt    DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  voucherPdfLogoSettings SiteSettings[]        @relation("SiteSettingsVoucherPdfLogo")
  contactPhotoSettings   SiteSettings[]        @relation("SiteSettingsContactPhoto")
  homePortraitSettings   SiteSettings[]        @relation("SiteSettingsHomePortrait")
  aboutPortraitSettings  SiteSettings[]        @relation("SiteSettingsAboutPortrait")
  collectionItems        MediaCollectionItem[]
  serviceMedia           ServiceMedia[]

  @@index([deletionRequestedAt])
  @@index([createdAt])
  @@index([visibility, createdAt])
  @@index([storageProvider, createdAt])
}

model MediaCollection {
  id        String                @id @default(cuid())
  type      MediaCollectionType   @unique
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  items     MediaCollectionItem[]
}

model MediaCollectionItem {
  id           String          @id @default(cuid())
  collectionId String
  mediaAssetId String
  sortOrder    Int
  isVisible    Boolean         @default(true)
  altText      String?
  caption      String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  collection   MediaCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([collectionId, mediaAssetId])
  @@unique([collectionId, sortOrder])
  @@index([mediaAssetId])
  @@index([collectionId, isVisible, sortOrder, id])
}
