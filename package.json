{
  "name": "ppstudio",
  "version": "3.29.0",
  "private": true,
  "engines": {
    "node": "^24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "clean": "rm -rf .next",
    "clean:e2e": "rm -rf .next-e2e",
    "predev": "prisma generate",
    "dev": "next dev",
    "dev:clean": "npm run clean && npm run dev",
    "dev:fast": "next dev",
    "dev:clean:fast": "npm run clean && next dev",
    "dev:webpack": "next dev --webpack",
    "dev:turbopack": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:db:integration",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:release": "node --import ./src/test/register-server-only.mjs --import tsx --test --test-isolation=process --test-concurrency=4 \"src/**/*.test.{ts,tsx}\"",
    "test:release-script": "bash deploy/release.test.sh",
    "test:coverage": "rm -rf coverage .nyc_output && c8 node --import ./src/test/register-server-only.mjs --import tsx --test --test-isolation=process --test-concurrency=4 \"src/**/*.test.{ts,tsx}\"",
    "pretest:e2e": "PLAYWRIGHT_PORT=${PLAYWRIGHT_PORT:-3100}; export PLAYWRIGHT_PORT; PPSTUDIO_NEXT_DIST_DIR=.next-e2e PUSHOVER_ENABLED=false NEXT_PUBLIC_APP_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:$PLAYWRIGHT_PORT} NEXT_PUBLIC_SITE_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:$PLAYWRIGHT_PORT} NEXT_PUBLIC_MATOMO_ENABLED=true NEXT_PUBLIC_MATOMO_URL=https://matomo.example.test/ NEXT_PUBLIC_MATOMO_SITE_ID=1 NEXT_PUBLIC_META_PIXEL_ENABLED=true NEXT_PUBLIC_META_PIXEL_ID=123456789 npm run build",
    "test:e2e": "PPSTUDIO_NEXT_DIST_DIR=.next-e2e playwright test",
    "deps:check": "npm ping --registry=${PPSTUDIO_NPM_REGISTRY:-https://registry.npmjs.org/}",
    "deps:install": "npm ci --include=dev --registry=${PPSTUDIO_NPM_REGISTRY:-https://registry.npmjs.org/}",
    "test:db:integration": "RUN_DB_INTEGRATION_TESTS=1 node --import ./src/test/register-server-only.mjs --import tsx --test --test-concurrency=1 \"src/**/*.integration.test.ts\"",
    "test:db:booking": "RUN_DB_INTEGRATION_TESTS=1 node --import ./src/test/register-server-only.mjs --import tsx --test --test-concurrency=1 src/features/booking/lib/*.integration.test.ts",
    "test:db:admin-logs": "RUN_DB_INTEGRATION_TESTS=1 node --import ./src/test/register-server-only.mjs --import tsx --test --test-concurrency=1 src/features/admin/lib/admin-logs.integration.test.ts src/lib/email/incident-resolution.integration.test.ts",
    "test:db:admin-logs:utc": "TZ=UTC npm run test:db:admin-logs",
    "test:ci": "npm run test:coverage:unit && npm run test:db:integration",
    "test:coverage:unit": "node scripts/run-unit-tests.mjs --coverage",
    "email:worker": "tsx scripts/email-delivery-worker.ts",
    "email:worker:once": "tsx scripts/email-delivery-worker.ts --once",
    "email:worker:check-imports": "tsx scripts/check-email-worker-imports.ts",
    "email:dev": "email dev --dir src/lib/email/react-email",
    "email:previews": "NODE_ENV=test tsx scripts/generate-email-previews.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:check-migrations": "node scripts/check-migration-history.mjs",
    "analytics:check": "node scripts/check-matomo-reporting.mjs",
    "changelog:check": "node scripts/check-changelog.mjs",
    "version:check": "node scripts/check-version-consistency.mjs",
    "test:changelog": "node --test scripts/check-changelog.test.mjs",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:import-services": "tsx scripts/import-services.mjs",
    "db:backfill-service-copy": "tsx scripts/backfill-service-copy.ts",
    "db:backfill-media-library-v2": "tsx scripts/media-library-v2-backfill.ts",
    "db:cleanup-rate-limits": "tsx scripts/cleanup-rate-limit-reservations.ts",
    "admin:recover-owner": "tsx scripts/recover-admin-owner.ts",
    "db:clear-booking-data": "node scripts/clear-booking-data.mjs",
    "media:audit": "tsx scripts/media-audit.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fullcalendar/react": "^7.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-toast": "^1.2.23",
    "@tanstack/react-table": "^9.2.4",
    "clsx": "^2.1.1",
    "jose": "^6.2.8",
    "next": "16.3.3",
    "nodemailer": "^9.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.9.3",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "svix": "^2.0.0",
    "tailwind-merge": "^3.6.0",
    "temporal-polyfill": "^1.0.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@react-email/ui": "6.9.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "c8": "^12.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "7.9.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "prisma@7.9.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@7.9.1": true
  },
  "overrides": {
    "eslint-config-next": {
      "eslint-plugin-import": {
        "minimatch": "10.2.5"
      },
      "eslint-plugin-jsx-a11y": {
        "minimatch": "10.2.5"
      },
      "eslint-plugin-react": {
        "minimatch": "10.2.5"
      }
    },
    "postcss": "8.5.23",
    "find-my-way": "9.7.0",
    "sharp": "$sharp",
    "deepmerge-ts": "8.0.1",
    "mysql2": "3.24.3"
  }
}
